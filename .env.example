# Скопировать в .env и заполнить. .env в репозиторий не попадает.

# Подпись сессий. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ключ шифрования паролей BMC в базе. Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеря ключа означает потерю всех сохранённых паролей.
FERNET_KEY=

# Первый администратор создаётся при первом старте. Дефолтных учёток нет:
# сервис хранит пароли от всех BMC, это худшее место для admin/admin123.
BOOTSTRAP_ADMIN=
BOOTSTRAP_PASSWORD=

# Адрес, по которому BMC видит наш SMB-сервер. Порт указать нельзя —
# прошивка не принимает двоеточие в поле Share host.
SHARE_HOST=

# Каталог с образами на хосте. Отдаётся по SMB как шара с именем ISO_SHARE.
ISO_DIR=/opt/iso
ISO_SHARE=iso

# Управление файрволом хоста через демон ipmi-fw-helper. Включено по
# умолчанию: без него порт 445 доступен всем, кто до него достучится, и
# защита сводится к проверке внутри Samba — то есть уже после того, как
# разборщик SMB1 принял пакет. Выключать осмысленно только там, где шара
# живёт в доверенной сети и доступ ограничен другими средствами.
FIREWALL_ENABLED=true

# Окно доступа к 445 порту. Продлевается, пока BMC подтверждает монтирование,
# и закрывается ядром само, если сервис упадёт.
FW_WINDOW_SECONDS=28800
MOUNT_POLL_SECONDS=300

# Адрес и порт панели. По умолчанию только localhost — наружу её выставляет
# nginx. Ставить 0.0.0.0 имеет смысл лишь если nginx перед сервисом нет, и
# тогда доступ обязан ограничивать файрвол узла.
BIND_ADDR=127.0.0.1
PORT=5006

# Набор шифров RMCP+ для ipmitool. Менять, только если на BMC разрешён другой:
# симптом несовпадения — «invalid role» при обращении к питанию.
IPMI_CIPHER_SUITE=3
