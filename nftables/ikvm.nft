# Доступ к SMB-раздаче образов.
#
# Это НЕ самостоятельный ruleset, а фрагмент для существующего
# /etc/nftables.conf. Отдельная таблица намеренно не заводится: на узлах, где
# уже есть белый список с `policy drop`, своя базовая цепочка ничего не решает —
# `accept` завершает обход только своей цепочки, и пакет всё равно приходит в
# основную, где его выбрасывает политика.
#
# Смысл конструкции: по умолчанию порт закрыт (политикой основной цепочки), а
# открытым его держит только наблюдаемый факт «монтирование идёт». Элементы
# множества имеют таймаут, и ядро удаляет их само — если сервис упадёт или
# контейнер убьют, порт всё равно закроется. Множество при загрузке пустое,
# поэтому после перезагрузки хоста состояние — «закрыто», а не «открыто».


# --- 1. В `table ip filter` добавить множество ---

    set ikvm_allow {
        type ipv4_addr
        flags timeout
        comment "адреса BMC, которым сейчас разрешено забирать образ"
    }


# --- 2. В `chain INPUT` того же файла добавить строку ---

        tcp dport 445 ip saddr @ikvm_allow accept


# --- 3. Применить вживую, НЕ перечитывая /etc/nftables.conf ---
#
# В начале файла стоит `flush ruleset`: его перечитывание снесёт цепочки,
# которые туда прописал Docker, и контейнеры с проброшенными портами потеряют
# доступность до перезапуска демона. Поэтому те же две сущности добавляются
# командами, а правка файла нужна лишь для того, чтобы пережить перезагрузку.
#
#   nft add set ip filter ikvm_allow '{ type ipv4_addr; flags timeout; }'
#   nft insert rule ip filter INPUT tcp dport 445 ip saddr @ikvm_allow accept
#
# Открыть окно на время монтирования:
#   nft add element ip filter ikvm_allow '{ 203.0.113.10 timeout 30m }'
#
# Закрыть немедленно (плюс добить уже установленную сессию, иначе она
# переживёт удаление элемента):
#   nft delete element ip filter ikvm_allow '{ 203.0.113.10 }'
#   conntrack -D -p tcp --dport 445 -s 203.0.113.10
